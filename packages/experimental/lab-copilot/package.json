{
  "name": "@deepseek-ai/dsh-lab-copilot",
  "description": "Restricted campus laboratory agent and local speech gateway",
  "version": "0.2.2-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-session-checkpoint-policy": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-attachment-local": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/lab-copilot"
  }
}
